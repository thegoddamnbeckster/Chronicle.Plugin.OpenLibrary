<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Chronicle.Plugin.OpenLibrary</AssemblyName>
    <RootNamespace>Chronicle.Plugin.OpenLibrary</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Chronicle Contributors</Authors>
    <Description>Open Library book and author metadata plugin for Chronicle. No API key required.</Description>
  </PropertyGroup>

  <!-- Chronicle.Plugins.dll is provided by the host at runtime: do NOT copy it to the output. A project reference (not a
       HintPath to a built DLL) so this plugin is rebuilt whenever the plugin API changes. -->
  <ItemGroup>
    <ProjectReference Include="..\Chronicle\src\Chronicle.Plugins\Chronicle.Plugins.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="9.0.*" />
    <!-- Serilog is loaded by the Chronicle host: reference it without bundling, pinned to the EXACT version Chronicle.API
         resolves (see src/Chronicle.API/obj/project.assets.json). A floating range let a plugin drift to a newer patch than the
         host has loaded, and .NET binding is exact-version-strict (Hardcover hit this on 2026-09-02). -->
    <PackageReference Include="Serilog" Version="4.3.1" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- The test project lives inside this repo; keep its sources out of the plugin assembly. -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <InternalsVisibleTo Include="Chronicle.Plugin.OpenLibrary.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
